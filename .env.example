# ================================================
#  NeuroMind AI — Environment Variables
#  1. Copy this file: cp .env.example .env
#  2. Fill in your values
#  3. NEVER commit your .env file to Git!
# ================================================

# ── Anthropic API ────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Model Configuration ──────────────────────────
MODEL_NAME=claude-sonnet-4-20250514
MAX_TOKENS=2048
TEMPERATURE=0.7

# ── App Settings ─────────────────────────────────
APP_TITLE=NeuroMind AI
MAX_MEMORY_TURNS=20
MAX_FILE_SIZE_MB=10

# ── Feature Flags ────────────────────────────────
ENABLE_IMAGE_ANALYSIS=true
ENABLE_CODE_ASSISTANT=true
ENABLE_DATA_ANALYST=true
ENABLE_DOCUMENT_QA=true
